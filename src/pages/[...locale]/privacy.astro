---
import Base from '../../layouts/Base.astro';
import { localePaths, page } from '../../lib/i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const { fm } = page(locale, 'privacy');
const HOSTAWAY_PRIVACY = 'https://www.hostaway.com/privacy-policy/';
---
<Base locale={locale} page="privacy" title={fm.title} description={fm.description} ogPhoto="33">
  <article class="section">
    <div class="container prose measure">
      <p class="kicker">{fm.kicker}</p>
      <h1>{fm.heading}</h1>
      {fm.sections.map((s: any) => (
        <>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
          {s.linkLabel && <p><a href={HOSTAWAY_PRIVACY} rel="noopener">{s.linkLabel}</a></p>}
        </>
      ))}
    </div>
  </article>
</Base>
