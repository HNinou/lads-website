---
// Closing call to action on content pages: Check dates + Ask a question.
import { weeklyFrom, whatsappHref } from '../lib/facts';
import { euros, pagePath, t } from '../lib/i18n';

interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="book-band">
  <div class="container inner reveal">
    <div>
      <p class="kicker">{t(locale, 'band.kicker')}</p>
      <h2>{t(locale, 'band.title')}</h2>
      <p class="text">{t(locale, 'band.text')}</p>
      {weeklyFrom && <p class="from">{t(locale, 'booking.from', { price: euros(locale, weeklyFrom) })}</p>}
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href={pagePath(locale, 'book')} data-cta="book">{t(locale, 'ui.checkDates')}</a>
      <a class="btn btn-ghost" href={whatsappHref} rel="noopener">{t(locale, 'ui.ask')}</a>
    </div>
  </div>
</section>

<style>
  .book-band { background: color-mix(in srgb, var(--c-sun) 20%, var(--c-bg)); border-top: 3px solid var(--c-sun); }
  .inner { padding-block: var(--space-5); display: grid; gap: var(--space-3); align-items: end; }
  @media (min-width: 900px) { .inner { grid-template-columns: 1fr auto; gap: var(--space-5); } }
  h2 { font-size: var(--step-3); }
  .text { max-width: 36rem; color: var(--c-ink); }
  .kicker { color: var(--c-ink); }
</style>
